# ─── Server Config ────────────────────────────────────
NODE_ENV=development
PORT=5000

# ─── MongoDB ──────────────────────────────────────────
MONGO_URI=mongodb://localhost:27017/doctor-appointments

# ─── JWT ──────────────────────────────────────────────
JWT_SECRET=your_super_secret_jwt_key_change_this
JWT_EXPIRES_IN=7d

# ─── CORS ─────────────────────────────────────────────
CLIENT_URL=http://localhost:5173

# ─── Email (leave blank to disable) ──────────────────
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USER=
EMAIL_PASS=
EMAIL_FROM="DocAppoint" <noreply@docappoint.com>
